; Copy this file to .env and fill in real values. Never commit .env.
EPOL_DB_HOST=10.90.144.153
EPOL_DB_PORT=65432
EPOL_DB_NAME=gis
EPOL_DB_USER=your_db_user
EPOL_DB_PASSWORD=your_db_password
EPOL_DB_SCHEMA=epoleodomia
EPOL_DB_CONNECT_TIMEOUT=10

; API stays on its reader account. Only sync_launcher.py uses these credentials.
; setup_sync_writer.py --apply creates and stores a generated sync password locally.
EPOL_SYNC_DB_USER=epol_sync
EPOL_SYNC_DB_PASSWORD=

; Existing listen defaults. The AutoCAD client uses port 8000.
EPOL_API_HOST=0.0.0.0
EPOL_API_PORT=8000

; Optional: EPOL_RASTER_BASE_PATH, EPOL_DJI_RASTER_PATH, EPOL_FEK_LOCAL_PATH.
; Without EPOL_RASTER_BASE_PATH, the catalog root follows EPOL_FEK_LOCAL_PATH.
; Optional versioned NAS archive; omitted/blank disables menu replication.
; EPOL_RASTER_NAS_PATH=\\10.90.144.153\Sp_net\epoleodomia_dir\spetses_urban_planning\raster_library\fek
; Process variables override this file, including legacy DB_* aliases.
; Use matching quotes for passwords containing whitespace followed by # or ;.
; Values are literal: !, %, $, = and Windows backslashes are not expanded.
